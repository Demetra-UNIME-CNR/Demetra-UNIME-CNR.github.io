    given-names: "[First name]"
    affiliation: "University of Messina — Stratus Lab"
    email: "stratus.lab@unime.it"
  - name: "CNR-IEIIT"
    city: "Torino"
    country: IT

keywords:
  - hyperspectral
  - NIR spectroscopy
  - precision agriculture
  - plant nutrient prediction
  - band selection
  - machine learning
  - remote sensing
  - Agriculture 4.0
  - PNRR

